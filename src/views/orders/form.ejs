<%- include('../partials/header') %>
<h1>New order <span class="muted">· <%= family.family_name %></span></h1>
<form method="post" action="/orders" class="card form">
  <%- include('../partials/csrf') %>
  <input type="hidden" name="family_id" value="<%= family.id %>">
  <label class="w-md">Date<input type="date" name="date" value="<%= today %>"></label>
  <table class="table">
    <thead><tr><th>Item</th><th>Season</th><th class="num">Price</th><th>Quantity</th></tr></thead>
    <% for (const p of products) { %>
    <tr><td><%= p.name %></td><td class="small muted"><%= p.season %></td><td class="num"><%= formatMoney(p.price) %></td>
      <td><input type="number" name="qty[p<%= p.id %>]" min="0" value="0" class="w-sm"></td></tr>
    <% } %>
    <% if (!products.length) { %><tr><td colspan="4" class="muted">No active products. <a href="/orders/products">Add products first.</a></td></tr><% } %>
  </table>
  <label>Notes<textarea name="notes" rows="2" placeholder="delivery instructions…"></textarea></label>
  <button class="btn">Create order</button>
</form>
<%- include('../partials/footer') %>
