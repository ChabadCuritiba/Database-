<%- include('../partials/header') %>
<div class="pagehead">
  <h1>Upcoming occasions</h1>
  <div class="actions">
    <a class="btn btn-light" href="/occasions/convert">Hebrew date converter</a>
    <a class="btn btn-light" href="/occasions/yahrzeit-letters">Yahrzeit letters</a>
    <% if (can('comms.send')) { %>
    <form method="post" action="/occasions/send-reminders" class="inline" data-confirm="Send all reminders that are due now?">
      <%- include('../partials/csrf') %><button class="btn">Send due reminders now</button>
    </form>
    <% } %>
  </div>
</div>
<form method="get" class="card filters-inline">
  <label>From <input type="date" name="from" value="<%= from %>"></label>
  <label>Next <input type="number" name="days" value="<%= days %>" min="1" max="400" class="w-sm"> days</label>
  <label>Type <select name="type"><option value="">All</option><% for (const t of types) { %><option value="<%= t %>" <%= type === t ? 'selected' : '' %>><%= OCCASION_LABELS[t] %></option><% } %></select></label>
  <button class="btn btn-small">Show</button>
</form>
<table class="table">
  <thead><tr><th>Date</th><th>Hebrew date</th><th>Type</th><th>Name</th><th>Family</th><th>Years</th></tr></thead>
  <% for (const o of list) { %>
  <tr>
    <td><strong><%= o.next.date %></strong><div class="small muted"><%= o.daysAway === 0 ? 'today' : `in ${o.daysAway} days` %></div></td>
    <td><%= o.next.hebrew.en %><div class="he small" dir="rtl"><%= o.next.hebrew.he %></div></td>
    <td><span class="badge badge-<%= o.type %>"><%= OCCASION_LABELS[o.type] %></span></td>
    <td><%= o.name %> <span class="he" dir="rtl"><%= o.hebrew_name %></span><div class="small muted"><%= o.relationship %></div></td>
    <td><a href="/families/<%= o.family_id %>"><%= o.family_name %></a></td>
    <td class="num"><%= o.next.count %></td>
  </tr>
  <% } %>
  <% if (!list.length) { %><tr><td colspan="6" class="muted">Nothing in this period.</td></tr><% } %>
</table>
<%- include('../partials/footer') %>
