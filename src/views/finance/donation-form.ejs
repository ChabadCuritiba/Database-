<%- include('../partials/header') %>
<h1>Record donation</h1>
<form method="post" action="/finance/donations" class="card form">
  <%- include('../partials/csrf') %>
  <div class="grid3">
    <label>Donor
      <% if (family) { %>
        <input type="hidden" name="family_id" value="<%= family.id %>"><input value="<%= family.family_name %>" readonly>
      <% } else { %>
        <input type="hidden" name="family_id" data-family-id>
        <input data-family-search placeholder="Type to search… (blank = anonymous)" autocomplete="off" list="family-results">
        <datalist id="family-results"></datalist>
      <% } %>
    </label>
    <label>Date<input type="date" name="date" value="<%= today %>" required></label>
    <label>Method<select name="method"><% for (const m of methods) { %><option><%= m %></option><% } %></select></label>
    <label>Reference<input name="reference" placeholder="check #, PIX id…"></label>
    <% if (pledges.length) { %>
    <label>Apply to pledge<select name="pledge_id"><option value="">—</option><% for (const p of pledges) { %><option value="<%= p.id %>" <%= pledgeId === p.id ? 'selected' : '' %>><%= p.fund_name %> – balance <%= formatMoney(p.balance) %></option><% } %></select></label>
    <% } %>
  </div>
  <fieldset><legend>Split across funds</legend>
    <div data-splits>
      <% for (let i = 0; i < 3; i++) { %>
      <div class="split-row">
        <select name="splits[<%= i %>][fund_id]"><% for (const f of funds) { %><option value="<%= f.id %>"><%= f.name %></option><% } %></select>
        <input name="splits[<%= i %>][amount]" placeholder="0,00" inputmode="decimal" <%= i === 0 ? 'required' : '' %>>
      </div>
      <% } %>
    </div>
    <p class="small muted">Leave unused rows empty. Total: <strong data-split-total>0,00</strong></p>
  </fieldset>
  <label>Notes<textarea name="notes" rows="2"></textarea></label>
  <button class="btn">Save</button>
  <button class="btn btn-light" name="another" value="1">Save &amp; add another</button>
</form>
<%- include('../partials/footer') %>
