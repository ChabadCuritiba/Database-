<%- include('../partials/header') %>
<h1>Funds</h1>
<p class="muted">Funds are the income categories donations are split across (e.g. General, Building Fund, Holiday Appeals).</p>
<table class="table">
  <thead><tr><th>Name</th><th>Tax-deductible</th><th>Active</th><th class="num">All-time total</th><% if (can('finance.write')) { %><th></th><% } %></tr></thead>
  <% for (const f of funds) { %>
  <tr>
    <% if (can('finance.write')) { %>
    <td colspan="3">
      <form method="post" action="/finance/funds/<%= f.id %>" class="inline-form" id="fund-<%= f.id %>">
        <%- include('../partials/csrf') %>
        <input name="name" value="<%= f.name %>">
        <label class="inline"><input type="checkbox" name="tax_deductible" value="1" <%= f.tax_deductible ? 'checked' : '' %>> tax-deductible</label>
        <label class="inline"><input type="checkbox" name="active" value="1" <%= f.active ? 'checked' : '' %>> active</label>
      </form>
    </td>
    <td class="num"><%= formatMoney(totals[f.id] || 0) %></td>
    <td><button class="btn btn-small" form="fund-<%= f.id %>">Save</button></td>
    <% } else { %>
    <td><%= f.name %></td><td><%= f.tax_deductible ? 'yes' : 'no' %></td><td><%= f.active ? 'yes' : 'no' %></td><td class="num"><%= formatMoney(totals[f.id] || 0) %></td>
    <% } %>
  </tr>
  <% } %>
</table>
<% if (can('finance.write')) { %>
<form method="post" action="/finance/funds" class="card form narrow">
  <%- include('../partials/csrf') %>
  <h2>New fund</h2>
  <label>Name<input name="name" required></label>
  <label class="inline"><input type="checkbox" name="tax_deductible" value="1" checked> Tax-deductible</label>
  <button class="btn">Create fund</button>
</form>
<% } %>
<%- include('../partials/footer') %>
