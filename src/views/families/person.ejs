<%- include('../partials/header') %>
<h1><%= title %> <span class="muted">· <%= family.family_name %></span></h1>
<form method="post" action="<%= person.id ? `/families/${family.id}/people/${person.id}` : `/families/${family.id}/people` %>" class="card form">
  <%- include('../partials/csrf') %>
  <div class="grid3">
    <label>Type of person
      <select name="relation"><% for (const [r, label] of Object.entries(RELATION_LABELS)) { %><option value="<%= r %>" <%= person.relation === r ? 'selected' : '' %>><%= label %></option><% } %></select>
    </label>
    <label>First name *<input name="first_name" value="<%= person.first_name %>" required></label>
    <label>Last name<input name="last_name" value="<%= person.last_name %>"></label>
    <label>Hebrew name<input name="hebrew_name" value="<%= person.hebrew_name %>" dir="auto"></label>
    <label>Father's Hebrew name<input name="father_hebrew_name" value="<%= person.father_hebrew_name %>" dir="auto"></label>
    <label>Mother's Hebrew name<input name="mother_hebrew_name" value="<%= person.mother_hebrew_name %>" dir="auto"></label>
    <label>Gender<select name="gender"><option value="">–</option><option value="M" <%= person.gender === 'M' ? 'selected' : '' %>>Male</option><option value="F" <%= person.gender === 'F' ? 'selected' : '' %>>Female</option></select></label>
    <label>Kohen / Levi / Yisrael<select name="lineage"><option value="">–</option><% for (const l of ['kohen','levi','yisrael']) { %><option value="<%= l %>" <%= person.lineage === l ? 'selected' : '' %>><%= l %></option><% } %></select></label>
    <label>Birth date<input type="date" name="birth_date" value="<%= person.birth_date %>" data-hebrew-preview="birth_after_sunset"><small class="muted" data-hebrew-out></small></label>
    <label>Email<input type="email" name="email" value="<%= person.email %>"></label>
    <label>Mobile<input name="mobile" value="<%= person.mobile %>"></label>
  </div>
  <div class="checks">
    <label class="inline"><input type="checkbox" name="birth_after_sunset" value="1" <%= person.birth_after_sunset ? 'checked' : '' %>> Born after sunset</label>
    <label class="inline"><input type="checkbox" name="deceased" value="1" <%= person.deceased ? 'checked' : '' %>> Deceased</label>
    <% if (!person.id) { %><label class="inline"><input type="checkbox" name="track_birthday" value="1" checked> Track Hebrew birthday</label><% } %>
  </div>
  <label>Notes<textarea name="notes" rows="2"><%= person.notes %></textarea></label>
  <button class="btn">Save</button> <a href="/families/<%= family.id %>">Cancel</a>
</form>
<% if (person.id) { %>
<form method="post" action="/families/<%= family.id %>/people/<%= person.id %>/delete" data-confirm="Remove <%= person.first_name %>?">
  <%- include('../partials/csrf') %><button class="btn btn-danger btn-small">Remove person</button>
</form>
<% } %>
<%- include('../partials/footer') %>
