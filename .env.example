# Copy to .env and fill in. Values already set in the environment take precedence.

NODE_ENV=production
PORT=3000
# Public URL of the app (used for Google sign-in callback and Stripe redirects)
BASE_URL=https://crm.example.org
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
DATABASE_PATH=./data/community.db
TZ=America/Sao_Paulo
LOCALE=pt-BR
CURRENCY=BRL

# --- Continue with Google ---
# Create an OAuth client (type "Web application") in Google Cloud Console and add
#   ${BASE_URL}/auth/google/callback  as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow accounts from this Google Workspace domain
GOOGLE_ALLOWED_DOMAIN=
# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=rabbi@example.org
# Development only: password-less login form (ignored when NODE_ENV=production)
DEV_LOGIN=0

# --- Email (SMTP), e.g. Google Workspace smtp-relay.gmail.com or any provider ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Beit Chabad <office@example.org>"

# --- SMS and robo-calls (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555555555

# --- Online payments (Stripe Checkout; card data never touches this server) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Buggy voice assistant (Google Gemini) ---
# Create a key at https://aistudio.google.com (Get API key). Use a project with
# billing enabled so Google does not use your data to improve its products.
GEMINI_API_KEY=
# Optional: a specific model id; empty = newest Gemini Flash model available
GEMINI_MODEL=

# --- Schedules (cron syntax, in TZ) ---
REMINDER_CRON=0 8 * * *
BACKUP_CRON=0 3 * * *
BACKUP_DIR=./backups
BACKUP_KEEP=30
# Optional: copy each backup to Google Cloud Storage (npm install @google-cloud/storage)
GCS_BUCKET=
