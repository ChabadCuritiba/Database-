<%- include('../partials/header') %>
<% const contactLabel = channel === 'email' ? 'email' : 'mobile number'; %>
<h1>New <%= { email: 'email campaign', sms: 'SMS campaign', call: 'robo-call' }[channel] %></h1>
<form method="post" action="/comms/preview" class="card form" data-recipients-form>
  <%- include('../partials/csrf') %>
  <input type="hidden" name="channel" value="<%= channel %>">

  <div class="recipients">
    <label for="recipient-search">To</label>
    <div class="recipient-box">
      <div class="chips" data-chips></div>
      <div class="combo">
        <input id="recipient-search" type="search" autocomplete="off" placeholder="Type a name or <%= contactLabel %>…" data-recipient-search>
        <div class="dropdown" data-dropdown hidden></div>
      </div>
    </div>
    <label class="inline all-toggle"><input type="checkbox" name="all" value="1" data-all-contacts>
      <strong>All contacts</strong>&nbsp;<span class="muted">(<%= contacts.length %> with an <%= contactLabel %>)</span></label>
    <p class="small muted" data-recipient-hint>Pick people from the list, tick “All contacts”, or leave empty and use the filters below.</p>

    <%# Plain checkbox list: used as-is without JavaScript, otherwise it feeds the dropdown. %>
    <div class="picker" data-picker>
      <% for (const c of contacts) { %>
        <label class="pick-row" data-id="<%= c.id %>" data-name="<%= c.family_name %>" data-sub="<%= c.salutation || '' %>" data-contact="<%= c.contact %>">
          <input type="checkbox" name="familyIds" value="<%= c.id %>">
          <span><strong><%= c.family_name %></strong> <span class="muted small"><%= c.salutation || '' %></span></span>
          <span class="small muted"><%= c.contact %></span>
        </label>
      <% } %>
    </div>
  </div>

  <details class="more-filters" data-filters>
    <summary>Filter by category, priority, city…</summary>
    <%- include('../partials/criteria', { criteria, categories, affiliations, sources, cities, hideSearch: true }) %>
  </details>

  <% if (channel === 'email') { %><label>Subject *<input name="subject" required></label><% } %>
  <% if (channel === 'call') { %><label>Recorded audio URL (optional — otherwise the text is read aloud)<input name="audio_url" type="url" placeholder="https://…/message.mp3"></label><% } %>
  <label><%= channel === 'call' ? 'Text to speak' : 'Message' %> *
    <textarea name="body" rows="<%= channel === 'email' ? 12 : 4 %>" required <%= channel === 'sms' ? 'maxlength=600' : '' %>></textarea>
  </label>
  <p class="small muted">Merge fields: {{salutation}}, {{family_name}}, {{hebrew_name}}, {{city}}, {{address}}, {{org_name}}.
    Contacts who opted out or have no <%= contactLabel %> are excluded automatically.</p>
  <button class="btn">Preview recipients</button>
</form>
<%- include('../partials/footer') %>
